{
  "name": "shadow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "next typegen --webpack && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
